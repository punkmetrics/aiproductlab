{
  "name": "aiproductlab",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently --names web,api \"npm run dev -w web\" \"npm run dev -w api\"",
    "build": "npm run build --workspaces"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false
  }
}
